# GENERATED by `yarn configure` from {{configFile}}.
# Edit templates/subgraph.yaml.mustache or the config file, not this file.
specVersion: 0.0.5
schema:
  file: ./schema.graphql
dataSources:
{{#deployments}}
  - kind: ethereum
    name: ERC20PoolFactory{{suffix}}
    network: {{network}}
    source:
      abi: ERC20PoolFactory
      address: "{{factory.address}}"
      startBlock: {{factory.startBlock}}
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      entities:
        - Pool
        - PoolCreated
        - PoolFactory
        - Token
      abis:
        - name: ERC20PoolFactory
          file: ./abis/ERC20PoolFactory.json
        - name: ERC20Pool
          file: ./abis/ERC20Pool.json
        - name: PoolInfoUtils
          file: ./abis/PoolInfoUtils.json
        - name: PoolInfoUtilsMulticall
          file: ./abis/PoolInfoUtilsMulticall.json
        - name: ERC20
          file: ./abis/tokens/ERC20.json
        - name: ERC20Bytes32
          file: ./abis/tokens/ERC20Bytes32.json
      eventHandlers:
        - event: PoolCreated(indexed address,indexed address,indexed address)
          handler: handlePoolCreated
      file: ./src/mappings/erc-20-pool-factory.ts
  - kind: ethereum
    name: PositionManager{{suffix}}
    network: {{network}}
    source:
      abi: PositionManager
      address: "{{positionManager.address}}"
      startBlock: {{positionManager.startBlock}}
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      entities:
        - Account
        - Approval
        - ApprovalForAll
        - Bucket
        - Burn
        - MemorializePosition
        - Mint
        - MoveLiquidity
        - PoolFactory
        - Position
        - PositionLend
        - PositionManager
        - RedeemPosition
        - Transfer
      abis:
        - name: PositionManager
          file: ./abis/PositionManager.json
        - name: ERC20PoolFactory
          file: ./abis/ERC20PoolFactory.json
        - name: ERC20Pool
          file: ./abis/ERC20Pool.json
        - name: PoolInfoUtils
          file: ./abis/PoolInfoUtils.json
        - name: PoolInfoUtilsMulticall
          file: ./abis/PoolInfoUtilsMulticall.json
      eventHandlers:
        - event: Approval(indexed address,indexed address,indexed uint256)
          handler: handleApproval
        - event: ApprovalForAll(indexed address,indexed address,bool)
          handler: handleApprovalForAll
        - event: Burn(indexed address,indexed uint256)
          handler: handleBurn
        - event: MemorializePosition(indexed address,uint256,uint256[])
          handler: handleMemorializePosition
        - event: Mint(indexed address,indexed address,uint256)
          handler: handleMint
        - event: MoveLiquidity(indexed address,uint256,uint256,uint256,uint256,uint256)
          handler: handleMoveLiquidity
        - event: RedeemPosition(indexed address,uint256,uint256[])
          handler: handleRedeemPosition
        - event: Transfer(indexed address,indexed address,indexed uint256)
          handler: handleTransfer
      file: ./src/mappings/position-manager.ts
{{/deployments}}
